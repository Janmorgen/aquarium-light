#pragma once

// Copy this file to "secrets.h" and fill in your own values.
// secrets.h is gitignored so credentials never enter version control.

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// POSIX TZ string for your region, including DST rules.
// Examples:
//   Mountain (US):  "MST7MDT,M3.2.0,M11.1.0"
//   Eastern  (US):  "EST5EDT,M3.2.0,M11.1.0"
//   Central Europe: "CET-1CEST,M3.5.0,M10.5.0/3"
#define TZ_INFO "MST7MDT,M3.2.0,M11.1.0"

// Wireless flashing. The device sits on the LAN with a listener open, so this
// is not optional - pick something long.
#define OTA_HOSTNAME "aquarium-light"
#define OTA_PASSWORD "change-this-ota-password"

// The web control page and its mutating endpoints. Reading status needs no
// credentials; changing anything does.
#define WEB_USER     "aquarium"
#define WEB_PASSWORD "change-this-web-password"

// Optional fixed address. Leave commented out for DHCP - but give the board a
// static lease on your router either way, or you will be hunting for its
// address after every outage.
// #define NET_STATIC_IP "192.168.1.50"
// #define NET_GATEWAY   "192.168.1.1"
// #define NET_SUBNET    "255.255.255.0"
// #define NET_DNS       "192.168.1.1"
