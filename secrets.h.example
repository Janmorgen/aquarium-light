#pragma once

// Copy this file to "secrets.h" and fill in your own values.
// secrets.h is gitignored so credentials never enter version control.

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// POSIX TZ string for your region, including DST rules.
// Examples:
//   Mountain (US):  "MST7MDT,M3.2.0,M11.1.0"
//   Eastern  (US):  "EST5EDT,M3.2.0,M11.1.0"
//   Central Europe: "CET-1CEST,M3.5.0,M10.5.0/3"
#define TZ_INFO "MST7MDT,M3.2.0,M11.1.0"
